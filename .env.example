# Copy to .env and fill in before running `docker compose up -d --build`

# Public URL of the app (no trailing slash). The website, API (/api) and Swagger (/swagger-ui)
# are all served on this one domain.
PUBLIC_URL=https://vrbalance.example.com

# Database
POSTGRES_DB=vrbalance
POSTGRES_USER=vrbalance
POSTGRES_PASSWORD=change-me

# Backend
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
SENDGRID_API_KEY=
# Seeds demo accounts (admin/admin etc.) on startup. Disable for real production data.
SEED_ENABLED=true

# Host port. Bound to 127.0.0.1 so only a reverse proxy on the host can reach it;
# set BIND_ADDRESS=0.0.0.0 to expose it directly.
BIND_ADDRESS=127.0.0.1
APP_PORT=8090

# Docker images (built by GitHub Actions). Pin IMAGE_TAG=sha-<commit> to roll back.
IMAGE_REGISTRY=ghcr.io/gavin1103
IMAGE_TAG=latest
